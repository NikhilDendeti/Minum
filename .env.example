# Copy to .env and fill in the keys. Never commit .env.
DJANGO_SECRET_KEY=change-me
DEBUG=true
DEMO_MODE=true
DEMO_TODAY=2026-11-12
MERCHANT_LANGUAGE=te-IN            # or hi-IN
DATABASE_URL=postgres://munim:munim@localhost:5433/munim
READONLY_DATABASE_URL=postgres://munim_ro:munim_ro@localhost:5433/munim

LLM_MODEL=gpt-4o
LLM_FALLBACK_MODEL=gpt-4o-mini        # retried once if gpt-4o times out or errors
OPENAI_API_KEY=
LLM_TIMEOUT_S=10

SPEECH_PROVIDER=sarvam              # sarvam | openai | prerecorded
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=ritu                # works for te-IN, hi-IN and en-IN on bulbul:v3

CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- production only (leave commented for local work) ---------------------------------------------------------------
# DEBUG=false                       # then DJANGO_SECRET_KEY must be a long random value
# ALLOWED_HOSTS=your-app.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app
# MEDIA_ROOT=/data/media            # audio and cached briefings: put on a persistent volume
# LANGGRAPH_DB=/data/langgraph.sqlite   # paused approvals: same volume
# DEMO_MODE=false                   # true shows the login code on screen and allows /api/reset and seed_demo
